# reference/ is ground truth exported from QIDI Print and QIDI's own software.
# Never let Git rewrite line endings here — the G-code must stay byte-exact.
reference/** -text -diff

# ...but our own commentary in reference/ is ordinary text and must stay diffable.
reference/*.md text eol=lf diff

# Profile JSONs are ours; normalise them.
profiles/**/*.json text eol=lf

# Our own GUI-sliced evidence: text, but pointless to diff line by line.
samples/**/*.gcode text eol=lf -diff
